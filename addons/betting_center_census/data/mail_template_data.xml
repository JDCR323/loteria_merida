<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_census_success" model="mail.template">
            <field name="name">Notificación de Censo Exitoso</field>
            <field name="model_id" ref="betting_center_census.model_betting_center_census"/>
            <field name="subject">Confirmación de Registro - Censo de Lotería</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="body_html" type="html">
                <div style="font-family: 'Century Gothic', Arial, sans-serif; max-width: 600px; margin: auto; border: 1px solid #e9ecef; border-radius: 8px; overflow: hidden;">
                    <div style="background-color: #017f33; padding: 20px; text-align: center;">
                        <h2 style="color: white; margin: 0;">¡Registro Recibido!</h2>
                    </div>
                    <div style="padding: 30px; background-color: #ffffff; color: #090915;">
                        <p>Estimado(a) <strong><t t-out="object.full_name or object.business_name"/></strong>,</p>
                        <p>Hemos recibido satisfactoriamente su información correspondiente al Registro de Sujetos Pasivos de Lotería.</p>
                        
                        <h4 style="border-bottom: 2px solid #017f33; padding-bottom: 5px;">Datos Principales del Negocio</h4>
                        <ul style="list-style-type: none; padding: 0;">
                            <li style="margin-bottom: 10px;"><strong>Nombre Comercial:</strong> <t t-out="object.commercial_name"/></li>
                            <li style="margin-bottom: 10px;"><strong>Dirección:</strong> <t t-out="object.address"/></li>
                            <li style="margin-bottom: 10px;"><strong>Municipio:</strong> <t t-out="object.municipality"/></li>
                            <li style="margin-bottom: 10px;"><strong>Comercializadora:</strong> <t t-out="object.commercializer"/></li>
                        </ul>

                        <p>Su documentación está en proceso de revisión. Una vez aprobada, nos pondremos en contacto con usted.</p>
                    </div>
                    <div style="background-color: #f8f9fa; padding: 15px; text-align: center; font-size: 12px; color: #6c757d;">
                        <p>Instituto de Beneficencia Pública y Asistencia Social (IBPAS) - Gobernación de Mérida</p>
                    </div>
                </div>
            </field>
        </record>
    </data>
</odoo>