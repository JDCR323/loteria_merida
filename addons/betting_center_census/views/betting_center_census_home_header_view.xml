<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_loteria_main_nav" inherit_id="website.layout" name="Navbar Institucional Integrada en el Main">
        
        <xpath expr="//header" position="attributes">
            <attribute name="style">display: none !important;</attribute>
        </xpath>

        <xpath expr="//header[@id='top']" position="replace">
            <div class=" my-4" style="font-family: 'Century Gothic', sans-serif;">
                <div class="card shadow-sm border-0 bg-white p-3" >
                    
                    <div class="d-flex justify-content-between align-items-center pb-3 border-bottom" style="border-color: #090915 !important;">
                        
                        <a href="https://merida.gob.ve" target="_blank" class="navbar-brand m-0 p-0" title="Gobernación del Estado Bolivariano de Mérida">
                            <img src="/betting_center_census/static/src/img/logo_gobernacion.png" 
                                 alt="Gobernación de Mérida" 
                                 style=" width: 200px; object-fit: contain;"/>
                        </a>

                        <a href="/" class="navbar-brand m-0 p-0" title="Lotería de Mérida">
                            <img src="/betting_center_census/static/src/img/LOTERIA.png" 
                                 alt="Lotería de Mérida Logo" 
                                 style="width: 200px; object-fit: contain;"/>
                        </a>

                        <a href="/about-us" class="navbar-brand m-0 p-0" title="Instituto de Beneficencia Pública y Asistencia Social">
                            <img src="/betting_center_census/static/src/img/logo_impprijp.png"    
                                 alt="IBPAS Mérida" 
                                 style="width: 200px; object-fit: contain;"/>
                        </a>

                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-3">
                        
                        <ul role="menu" class="nav navbar-nav flex-row gap-4 mb-0 top_menu">
                            <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                <t t-call="website.submenu">
                                    <t t-set="item_class" t-value="'nav-item'"/>
                                    <t t-set="link_class" t-value="'nav-link fw-bold text-uppercase small text-dark'"/>
                                </t>
                            </t>
                        </ul>

                        <!-- <div style="max-width: 300px; flex-grow: 1;">
                            <form method="get" class="o_searchbar_form s_searchbar_input" action="/website/search" data-snippet="s_searchbar_input">
                                <div role="search" class="input-group input-group-sm">
                                    <input type="search" name="search" class="search-query form-control oe_search_box rounded-start-pill border-0 bg-light ps-3" placeholder="Buscar en el portal..." data-search-type="all" data-limit="5"/>
                                    <button type="submit" aria-label="Búsqueda" class="btn oe_search_button rounded-end-pill bg-light border-0 px-3">
                                        <i class="oi oi-search" style="color: #017f33;"></i>
                                    </button>
                                </div>
                            </form>
                        </div> -->  

                        <div>
                            <a href="/census/register" class="btn text-white fw-bold px-4 shadow-sm" style="background-color: #d0142c; border-radius: 20px; font-size: 12px; letter-spacing: 0.5px;">
                                Censo Obligatorio
                            </a>
                        </div>

                    </div>

                </div>
            </div>
        </xpath>

    </template>
</odoo>