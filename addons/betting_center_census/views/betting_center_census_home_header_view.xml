<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_loteria_main_nav" inherit_id="website.layout" name="Navbar Institucional Integrada en el Main">
        
        <xpath expr="//header" position="attributes">
            <attribute name="style">display: none !important;</attribute>
        </xpath>

        <xpath expr="//header[@id='top']" position="replace">
            <div class="my-4" style="font-family: 'Century Gothic', sans-serif;">
                <div class="card shadow-sm border-0 bg-white p-3">
                    
                    <div class="row align-items-center pb-3 border-bottom m-0" style="border-color: #090915 !important;">
                        
                        <div class="col-4 p-0 text-start">
                            <a href="https://merida.gob.ve" target="_blank" class="d-inline-block" title="Gobernación del Estado Bolivariano de Mérida">
                                <img src="/betting_center_census/static/src/img/logo_gobernacion.png" 
                                     alt="Gobernación de Mérida" 
                                     style="height: 75px; width: 100%; max-width: 180px; object-fit: contain; object-position: left;"/>
                            </a>
                        </div>

                        <div class="col-4 p-0 text-center">
                            <a href="/" class="d-inline-block" title="Lotería de Mérida">
                                <img src="/betting_center_census/static/src/img/LOTERIA.png" 
                                     alt="Lotería de Mérida Logo" 
                                     style="height: 85px; width: 100%; max-width: 200px; object-fit: contain; object-position: center;"/>
                            </a>
                        </div>

                        <div class="col-4 p-0 text-end">
                            <a href="/about-us" class="d-inline-block" title="Instituto de Beneficencia Pública y Asistencia Social">
                                <img src="/betting_center_census/static/src/img/logo_justicia_paz.png"    
                                     alt="IBPAS Mérida" 
                                     style="height: 75px; width: 100%; max-width: 180px; object-fit: contain; object-position: right;"/>
                            </a>
                        </div>

                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-3">
                        
                        <ul role="menu" class="nav navbar-nav flex-row gap-4 mb-0 top_menu">
                            <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                <t t-call="website.submenu">
                                    <t t-set="item_class" t-value="'nav-item'"/>
                                    <t t-set="link_class" t-value="'nav-link fw-bold text-uppercase small text-dark'"/>
                                </t>
                            </t>
                        </ul>

                        <t t-set="admin_company" t-value="env.ref('base.main_company')"/>

                        <div class="d-flex align-items-center gap-3 border-start border-end px-3 flex-wrap d-none d-lg-flex" style="border-color: rgba(9, 9, 21, 0.12) !important;">
                            
                            <div class="d-flex align-items-center text-muted" style="font-size: 11px; max-width: 280px; line-height: 1.2;">
                                <i class="fa fa-map-marker fa-fw me-1 text-uppercase" style="color: #017f33; font-size: 13px;"></i>
                                <span>
                                    <strong>Dirección:</strong> 
                                    <span t-out="admin_company.street"/>
                                </span>
                            </div>

                            <a t-attf-href="tel:#{admin_company.phone}" class="d-flex align-items-center text-decoration-none text-muted" style="font-size: 11px;" title="Llamar a la institución">
                                <i class="fa fa-phone fa-fw me-1" style="color: #017f33; font-size: 13px;"></i>
                                <span><strong>Telf:</strong> <span t-out="admin_company.phone"/></span>
                            </a>

                            <a t-attf-href="mailto:#{admin_company.email}" class="d-flex align-items-center text-decoration-none text-muted" style="font-size: 11px;" title="Enviar correo institucional">
                                <i class="fa fa-envelope fa-fw me-1" style="color: #017f33; font-size: 13px;"></i>
                                <span t-out="admin_company.email"/>
                            </a>

                        </div>

                        <div class="d-flex align-items-center gap-2 flex-wrap">
        
                            <t t-if="user_id.id != website.user_id.id">
                                <div class="d-flex align-items-center me-2 text-dark fw-bold small">
                                    <i class="fa fa-user me-1" style="color: #017f33; font-size: 22px;"></i>
                                    <span t-out="user_id.name" class="d-none d-sm-inline"/>
                                </div>

                                <a role="menuitem" 
                                href="/web/session/logout?redirect=/" 
                                class="btn btn-sm btn-outline-danger fw-bold d-flex align-items-center text-uppercase px-3" 
                                style="border-radius: 5px; font-size: 18px; ">
                                    <i class="fa fa-sign-out me-1"></i> Cerrar Sesión
                                </a>
                            </t>

                            <t t-else="">
                                <a href="/web/login" 
                                class="btn btn-sm fw-bold px-3 text-uppercase me-1" 
                                style="color: #090915; border: 1px solid #090915; border-radius: 5px; font-size: 18px; letter-spacing: 0.5px; transition: all 0.3s ease;">
                                    <i class="fa fa-sign-in me-1"></i> Iniciar Sesión
                                </a>

                                <a href="/census/register" 
                                class="btn text-white fw-bold btn-sm px-3 text-uppercase shadow-sm" 
                                style="background-color: #d0142c; border-radius: 5px; font-size: 18px; letter-spacing: 0.5px;">
                                    Censo Obligatorio
                                </a>
                            </t>
                            
                        </div>

                    </div>

                </div>
            </div>
        </xpath>

    </template>
</odoo>