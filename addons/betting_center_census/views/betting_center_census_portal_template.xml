<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_census" inherit_id="portal.portal_my_home" name="Portal: Mi Registro / Negocio">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="replace">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Mi Registro / Negocio</t>
                <t t-set="url" t-value="'/my/census'"/>
                <t t-set="placeholder_count" t-value="'1'"/>
            </t>
        </xpath>
    </template>

    <template id="portal_my_census_details" name="Mis Datos de Negocio">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title">Mis Datos de Registro</t>
            
            <div class="card shadow-sm mb-4">
                <div class="card-header text-white" style="background-color: #017f33;">
                    <h5 class="mb-0">Información del Establecimiento Registrado</h5>
                </div>
                <div class="card-body" t-if="census">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <strong class="text-muted d-block">Nombre Comercial</strong>
                            <span t-out="census.commercial_name"/>
                        </div>
                        <div class="col-md-6 mb-3">
                            <strong class="text-muted d-block">Comercializadora</strong>
                            <span t-out="census.commercializer"/>
                        </div>
                        <div class="col-md-12 mb-3">
                            <strong class="text-muted d-block">Dirección</strong>
                            <span t-out="census.address"/>
                        </div>
                    </div>
                </div>
                <div class="card-body" t-else="">
                    <p class="text-muted">No se encontraron datos de registro asociados a esta cuenta.</p>
                </div>
            </div>
        </t>
    </template>
</odoo>