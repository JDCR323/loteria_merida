<odoo>
    <data>
        <record id="seq_betting_center_census" model="ir.sequence">
            <field name="name">Secuencia Censo Lotería</field>
            <field name="code">betting.center.census.seq</field>
            <field name="prefix">CENSO-%(year)s-</field>
            <field name="padding">5</field>
        </record>

        <record id="view_betting_center_census_form" model="ir.ui.view">
            <field name="name">betting.center.census.form</field>
            <field name="model">betting.center.census</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_approve_and_create_user" 
                                string="Aprobar y Generar Usuario" 
                                type="object" 
                                class="oe_highlight" 
                                invisible="state != 'review'"/>
                        <button name="action_reject" 
                                string="Rechazar" 
                                type="object" 
                                class="btn-danger" 
                                invisible="state != 'review'"/>
                                
                        <field name="state" widget="statusbar" statusbar_visible="draft,review,approved"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="census_code"/></h1>
                            <h2><field name="commercial_name" placeholder="Nombre del Establecimiento"/></h2>
                        </div>
                        
                        <group>
                            <field name="person_type" widget="radio" options="{'horizontal': true}"/>
                        </group>

                        <notebook>
                            <page string="Datos del Solicitante">
                                <group invisible="person_type != 'natural'">
                                    <field name="full_name"/>
                                    <field name="identity_card"/>
                                    <field name="rif_natural"/>
                                    <field name="civil_status"/>
                                    <field name="nationality"/>
                                </group>
                                <group invisible="person_type != 'legal'">
                                    <field name="business_name"/>
                                    <field name="rif_legal"/>
                                    <field name="registry_number"/>
                                    <field name="social_objective"/>
                                    <field name="legal_representative"/>
                                    <field name="rep_identity_card"/>
                                </group>
                            </page>
                            
                            <page string="Establecimiento">
                                <group>
                                    <field name="address"/>
                                    <group>
                                        <field name="municipality"/>
                                        <field name="parish"/>
                                        <field name="municipal_license"/>
                                    </group>
                                    <group>
                                        <field name="phone"/>
                                        <field name="email"/>
                                    </group>
                                </group>
                            </page>

                            <page string="Operativa">
                                <group>
                                    <field name="commercializer"/>
                                    <field name="software"/>
                                    <field name="terminals_count"/>
                                </group>
                                <group string="Juegos Comercializados">
                                    <field name="game_animalitos"/>
                                    <field name="game_traditional"/>
                                    <label for="game_other_check" string="Otros Juegos"/>
                                    <div class="o_row">
                                        <field name="game_other_check"/>
                                        <field name="game_other_text" placeholder="Especifique..." invisible="game_other_check == False"/>
                                    </div>
                                </group>
                            </page>

                            <page string="Recaudos Digitales">
                                <group string="Documentación General">
                                    <field name="req_id_rif" filename="req_id_rif_name"/>
                                    <field name="req_funds_origin" filename="req_funds_origin_name"/>
                                    <field name="req_property" filename="req_property_name"/>
                                    <field name="req_conalot" filename="req_conalot_name"/>
                                    <field name="req_photos" filename="req_photos_name"/>
                                </group>
                                <group string="Documentación Jurídica/Comercial">
                                    <field name="req_charter" filename="req_charter_name"/>
                                    <field name="req_shareholders" filename="req_shareholders_name"/>
                                    <field name="req_islr" filename="req_islr_name"/>
                                    <field name="req_economic_license" filename="req_economic_license_name"/>
                                    <field name="req_mercantile_registry" filename="req_mercantile_registry_name"/>
                                </group>
                            </page>

                            <page string="Pagos y Control">
                                <group string="Constancia de Pago">
                                    <field name="payment_reference"/>
                                    <field name="payment_date"/>
                                    <field name="payment_amount"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                                <group string="Declaración Jurada">
                                    <field name="sworn_declaration"/>
                                </group>
                                <group string="Uso Interno del IOBPAS">
                                    <field name="reception_date"/>
                                    <field name="receiver_user_id"/>
                                    <field name="user_id"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_betting_center_census_list" model="ir.ui.view">
            <field name="name">betting.center.census.list</field>
            <field name="model">betting.center.census</field>
            <field name="arch" type="xml">
                <list decoration-info="state == 'review'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'">
                    <field name="census_code"/>
                    <field name="commercial_name"/>
                    <field name="person_type"/>
                    <field name="municipality"/>
                    <field name="commercializer"/>
                    <field name="reception_date"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="action_betting_center_census" model="ir.actions.act_window">
            <field name="name">Gestión de Censos Lotería</field>
            <field name="res_model">betting.center.census</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>